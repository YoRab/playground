{
  "name": "playground",
  "version": "1.0.0",
  "description": "",
  "author": "Yohann Rabatel",
  "main": "index.js",
  "license": "ISC",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "pnpm -r --parallel dev",
    "start:client": "pnpm --filter front dev",
    "start:server": "pnpm --filter back dev",
    "build": "pnpm build:common && pnpm build:client && pnpm build:server",
    "build:client": "pnpm --filter front build",
    "build:common": "pnpm --filter common build",
    "build:server": "pnpm --filter back build",
    "lint": "biome check --write projects/back/src projects/front/src projects/common/src"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.2",
    "@types/node": "22.7.0",
    "typescript": "5.6.2"
  }
}
