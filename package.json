{
  "name": "playground",
  "version": "1.0.0",
  "description": "",
  "author": "Yohann Rabatel",
  "main": "index.js",
  "license": "ISC",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "pnpm -r --parallel dev",
    "start:client": "pnpm --filter front dev",
    "start:server": "pnpm --filter back dev",
    "build": "pnpm build:server && pnpm build:client",
    "build:client": "pnpm --filter front build",
    "build:server": "pnpm --filter back build",
    "lint": "biome check --write projects/back/src projects/front/src projects/platform projects/apps"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
