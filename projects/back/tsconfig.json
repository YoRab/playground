{
  // type checking only: the server runs from the sources with tsx (dev and prod),
  // which resolves the path aliases of tsconfig.base.json (@back, @platform, @apps)
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node"],
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["src"]
}
